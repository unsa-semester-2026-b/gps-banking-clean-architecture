{
  "name": "ejemplo-clean-architecture",
  "version": "1.0.0",
  "description": "Mini banco en TypeScript que aplica Clean Architecture de forma estricta y didáctica",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app/main.ts",
    "start": "tsx src/app/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "dependency-cruiser": "^16.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
